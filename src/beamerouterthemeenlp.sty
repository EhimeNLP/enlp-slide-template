% Templates
\defbeamertemplate*{headline}{enlp}{}

\defbeamertemplate*{background}{enlp}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0pt] at (current page.south west) {%
      \ifdefstring{\enlp@bgstate}{title}{\enlp@bg@title}{%
      \ifdefstring{\enlp@bgstate}{heading}{\enlp@bg@heading}{%
      \ifdefstring{\enlp@bgstate}{content}{\enlp@bg@content}{}}}%
    };
  \end{tikzpicture}%
}

\defbeamertemplate*{frametitle}{enlp}{
  \vspace*{\enlp@frametitletopskip}
  \begin{beamercolorbox}[wd=\dimexpr\paperwidth-\enlp@contentleftmargin-\enlp@contentrightmargin\relax,ht=\enlp@frametitleheight,dp=\enlp@frametitledepth,left]{frametitle}
    \hspace*{\enlp@frametitleinnerleft}\usebeamerfont{frametitle}\insertframetitle
    \ifx\insertframesubtitle\@empty\else
      \par\vspace{0.9mm}
      \hspace*{\enlp@frametitleinnerleft}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}
    \fi
  \end{beamercolorbox}
  \vspace{\enlp@afterframetitleskip}
}

\defbeamertemplate*{footline}{enlp}{
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,text width=.72\paperwidth,inner sep=0pt,align=left]
      at ([xshift=.069\paperwidth,yshift=.045\paperheight]current page.south west)
      {\usebeamerfont{footline}\color{enlpMuted}\enlp@renderframefooter};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-.031\paperwidth,yshift=.043\paperheight]current page.south east)
      {\usebeamerfont{footline}\color{enlpMuted}\insertframenumber};
  \end{tikzpicture}
  \vspace{5.8mm}
}


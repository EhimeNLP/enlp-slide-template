% Margins & Title properties
\newlength{\enlp@contentleftmargin}
\newlength{\enlp@contentrightmargin}
\newlength{\enlp@frametitletopskip}
\newlength{\enlp@frametitleinnerleft}
\newlength{\enlp@frametitleheight}
\newlength{\enlp@frametitledepth}
\newlength{\enlp@afterframetitleskip}
\setlength{\enlp@contentleftmargin}{24.0mm}
\setlength{\enlp@contentrightmargin}{24.0mm}
\setlength{\enlp@frametitletopskip}{10.8mm}
\setlength{\enlp@frametitleinnerleft}{1.6mm}
\setlength{\enlp@frametitleheight}{15.2mm}
\setlength{\enlp@frametitledepth}{2.0mm}
\setlength{\enlp@afterframetitleskip}{5.2mm}

\setbeamersize{text margin left=\the\enlp@contentleftmargin,text margin right=\the\enlp@contentrightmargin}
\setbeamertemplate{navigation symbols}{}

\beamer@centeredfalse
\define@key{beamerframe}{t}[true]{%
  \beamer@frametopskip=0pt\relax%
  \beamer@framebottomskip=0pt plus 0.001fill\relax%
  \beamer@frametopskipautobreak=\beamer@frametopskip\relax%
  \beamer@framebottomskipautobreak=\beamer@framebottomskip\relax%
}


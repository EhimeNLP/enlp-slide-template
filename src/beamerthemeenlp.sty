\defbeamertemplate{block begin}{enlp}{%
  \par\vskip\medskipamount%
  \begin{beamercolorbox}[wd=\linewidth,sep=1.4mm,leftskip=1.6mm,rightskip=1.6mm]{block title}%
    \usebeamerfont{block title}\insertblocktitle%
  \end{beamercolorbox}%
  {\parskip0pt\par}%
  \begin{beamercolorbox}[wd=\linewidth,sep=1.8mm,leftskip=1.6mm,rightskip=1.6mm,vmode]{block body}%
    \usebeamerfont{block body}%
}

\defbeamertemplate{block end}{enlp}{%
  \end{beamercolorbox}%
}

\defbeamertemplate*{title page}{enlp}{
  \ifx\insertsubtitle\@empty\else
    \begin{textblock*}{\enlp@subtitlewidth}(\enlp@subtitlex,\dimexpr0pt-\enlp@subtitley\relax)
      {\raggedright\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
    \end{textblock*}
  \fi
  \ifx\insertdate\@empty\else
    \begin{textblock*}{\enlp@datewidth}(\enlp@datex,\dimexpr0pt-\enlp@datey\relax)
      {\raggedright\usebeamerfont{date}\color{enlpText}\insertdate\par}
    \end{textblock*}
  \fi
  \begin{textblock*}{\enlp@titlewidth}(\dimexpr\enlp@titlex-\enlp@titlewidth/2\relax,\dimexpr0pt-\enlp@titley\relax)
    {\centering\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
  \end{textblock*}
  \ifx\insertinstitute\@empty\else
    \begin{textblock*}{\enlp@institutewidth}(\dimexpr\enlp@institutex-\enlp@institutewidth/2\relax,\dimexpr0pt-\enlp@institutey\relax)
      {\centering\usebeamerfont{institute}\color{enlpText}\insertinstitute\par}
    \end{textblock*}
  \fi
  \begin{textblock*}{\enlp@authorwidth}(\dimexpr\enlp@authorx-\enlp@authorwidth/2\relax,\dimexpr0pt-\enlp@authory\relax)
    {\centering\usebeamerfont{author}\color{enlpText}\insertauthor\par}
  \end{textblock*}
  \null
}

\defbeamertemplate*{headline}{enlp}{}

\defbeamertemplate*{background}{enlp}{%
  \ifstrempty{\enlp@activebgpath}{}{%
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=center,inner sep=0pt] at (current page.center)
        {\includegraphics[width=\paperwidth,height=\paperheight]{\enlp@activebgpath}};
    \end{tikzpicture}%
  }%
}

\defbeamertemplate*{frametitle}{enlp}{
  \vspace*{\enlp@frametitletopskip}
  \begin{beamercolorbox}[wd=\dimexpr\paperwidth-\enlp@contentleftmargin-\enlp@contentrightmargin\relax,ht=\enlp@frametitleheight,dp=\enlp@frametitledepth,left]{frametitle}
    \hspace*{\enlp@frametitleinnerleft}\usebeamerfont{frametitle}\insertframetitle
    \ifx\insertframesubtitle\@empty\else
      \par\vspace{0.9mm}
      \hspace*{\enlp@frametitleinnerleft}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}
    \fi
  \end{beamercolorbox}
  \vspace{\enlp@afterframetitleskip}
}


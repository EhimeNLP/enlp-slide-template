\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeenlp}[2026/04/09 Ehime NLP Lab Beamer theme]

\RequirePackage{etoolbox}
\RequirePackage{xparse}

\mode<presentation>

% Load sub-themes
\usecolortheme{enlp}
\usefonttheme{enlp}
\useinnertheme{enlp}
\useoutertheme{enlp}

% Options & Bibliography Configuration
\newcommand{\enlp@selectedbibmode}{biblatex}
\newcommand{\enlp@biblatexoptions}{}
\newcommand{\enlp@bibtexoptions}{numbers,sort&compress,super}
\newcommand{\enlp@bibtexstyle}{enlpbeamer}
\newif\ifenlp@autocitefooter
\enlp@autocitefootertrue
\DeclareOptionBeamer{bib}[biblatex]{\def\enlp@selectedbibmode{#1}}
\DeclareOptionBeamer{biblatex}{\def\enlp@selectedbibmode{biblatex}}
\DeclareOptionBeamer{bibtex}{\def\enlp@selectedbibmode{bibtex}}
\DeclareOptionBeamer{biblatexopts}{\def\enlp@biblatexoptions{#1}}
\DeclareOptionBeamer{bibtexopts}{\def\enlp@bibtexoptions{#1}}
\DeclareOptionBeamer{bibtexstyle}{\def\enlp@bibtexstyle{#1}}
\DeclareOptionBeamer{autocitefooter}[true]{%
  \ifdefstring{#1}{false}{%
    \enlp@autocitefooterfalse
  }{%
    \enlp@autocitefootertrue
  }%
}
\DeclareOptionBeamer{noautocitefooter}{\enlp@autocitefooterfalse}
\ProcessOptionsBeamer

% Page Size
\newcommand{\enlp@pagewidth}{33.87cm}
\newcommand{\enlp@pageheight}{19.05cm}
\newcommand{\enlp@applypagesize}{%
  \setlength{\paperwidth}{\enlp@pagewidth}%
  \setlength{\paperheight}{\enlp@pageheight}%
  \geometry{paperwidth=\enlp@pagewidth,paperheight=\enlp@pageheight}%
}
\newcommand{\enlpsetpagesize}[2]{%
  \gdef\enlp@pagewidth{#1}%
  \gdef\enlp@pageheight{#2}%
  \enlp@applypagesize
}
\enlp@applypagesize

% Frame footer & Cite macros
\newcommand{\enlp@framefooter}{}
\let\enlp@autocitekeys\@empty
\newcommand{\enlp@bibmode}{none}
\newcommand{\enlp@bibfiles}{}
\newif\ifenlp@firstfootercite
\newcommand{\framefooter}[1]{\gdef\enlp@framefooter{#1}}

\newcommand{\enlp@natbiblabelcite}[1]{[\citenum{#1}]}
\newcommand{\enlp@footcitelabel}[1]{%
  \begingroup
  \NoHyper
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \parencite{#1}%
  }{%
    \enlp@natbiblabelcite{#1}%
  }%
  \endNoHyper
  \endgroup
}
\newcommand{\enlp@addautocitekey}[1]{%
  \begingroup
  \edef\enlp@normalizedcitekey{\zap@space#1 \@empty}%
  \ifstrempty{\enlp@normalizedcitekey}{}{%
    \expandafter\ifinlist\expandafter{\enlp@normalizedcitekey}{\enlp@autocitekeys}{}{%
      \ifx\enlp@autocitekeys\@empty
        \xdef\enlp@autocitekeys{\enlp@normalizedcitekey}%
      \else
        \xdef\enlp@autocitekeys{\enlp@autocitekeys,\enlp@normalizedcitekey}%
      \fi
    }%
  }%
  \endgroup
}
\newcommand{\enlp@trackcitekeys}[1]{%
  \ifenlp@autocitefooter
    \def\do##1{\enlp@addautocitekey{##1}}%
    \docsvlist{#1}%
  \fi
}
\newcommand{\enlp@callcitemacro}[5]{%
  \IfBooleanTF{#2}{%
    \IfNoValueTF{#3}{%
      \IfNoValueTF{#4}{%
        #1*{#5}%
      }{%
        #1*[][#4]{#5}%
      }%
    }{%
      \IfNoValueTF{#4}{%
        #1*[#3]{#5}%
      }{%
        #1*[#3][#4]{#5}%
      }%
    }%
  }{%
    \IfNoValueTF{#3}{%
      \IfNoValueTF{#4}{%
        #1{#5}%
      }{%
        #1[][#4]{#5}%
      }%
    }{%
      \IfNoValueTF{#4}{%
        #1[#3]{#5}%
      }{%
        #1[#3][#4]{#5}%
      }%
    }%
  }%
}
\newcommand{\enlp@installcitewrapper}[1]{%
  \@ifundefined{#1}{}{%
    \@ifundefined{enlp@orig@#1}{%
      \csletcs{enlp@orig@#1}{#1}%
      \expandafter\RenewDocumentCommand\csname #1\endcsname{s o o m}{%
        \enlp@trackcitekeys{##4}%
        \expandafter\enlp@callcitemacro\expandafter{\csname enlp@orig@#1\endcsname}{##1}{##2}{##3}{##4}%
      }%
    }{}%
  }%
}
\newcommand{\enlp@installbiblatexcitewrappers}{%
  \enlp@installcitewrapper{cite}%
  \enlp@installcitewrapper{textcite}%
  \enlp@installcitewrapper{parencite}%
}
\newcommand{\enlp@installbibtexcitewrappers}{%
  \enlp@installcitewrapper{cite}%
  \enlp@installcitewrapper{citet}%
  \enlp@installcitewrapper{citep}%
}
\newcommand{\enlpusebiblatex}[2][]{%
  \@ifpackageloaded{biblatex}{}{%
    \RequirePackage[
      backend=biber,
      style=enlpbeamer,
      #1
    ]{biblatex}%
  }%
  \gdef\enlp@bibmode{biblatex}%
  \ifstrempty{#2}{}{%
    \addbibresource{#2}%
  }%
  \enlp@installbiblatexcitewrappers
}
\newcommand{\enlpusebibtex}[3][]{%
  \@ifpackageloaded{natbib}{}{%
    \RequirePackage[#1]{natbib}%
  }%
  \@ifpackageloaded{bibentry}{}{%
    \RequirePackage{bibentry}%
  }%
  \gdef\enlp@bibmode{bibtex}%
  \gdef\enlp@bibfiles{#3}%
  \bibliographystyle{#2}%
  \ifstrempty{#3}{}{%
    \nobibliography*%
  }%
  \enlp@installbibtexcitewrappers
}
\newcommand{\enlpusebibresource}[1]{%
  \ifdefstring{\enlp@selectedbibmode}{bibtex}{%
    \ifstrempty{#1}{%
      \expandafter\enlpusebibtex\expandafter[\enlp@bibtexoptions]{\enlp@bibtexstyle}{}%
    }{%
      \filename@parse{#1}%
      \edef\enlp@resolvedbibfile{\filename@area\filename@base}%
      \expandafter\enlpusebibtex\expandafter[\enlp@bibtexoptions]{\enlp@bibtexstyle}{\enlp@resolvedbibfile}%
    }%
  }{%
    \expandafter\enlpusebiblatex\expandafter[\enlp@biblatexoptions]{#1}%
  }%
}
\newcommand{\enlp@requirebibsupport}[1]{%
  \ifdefstring{\enlp@bibmode}{none}{%
    \PackageError{beamerthemeenlp}{#1 requires bibliography setup}{%
      Use \string\enlpusebibresource, \string\enlpusebibtex, or \string\enlpusebiblatex\space in the preamble.%
    }%
  }{}%
}

% Special Frames
\newcommand{\enlp@sectionpageframe}[1]{%
  \def\insertsectionhead{#1}%
  \enlp@setactivebackground{heading}%
  \begin{frame}[plain,noframenumbering]
    \sectionpage
  \end{frame}
  \enlp@setactivebackground{content}%
}
\newcommand{\enlptitleframe}{%
  \enlp@setactivebackground{title}%
  \begin{frame}[plain,noframenumbering]
    \titlepage
  \end{frame}
  \enlp@setactivebackground{content}%
}
\newcommand{\enlpsectionframe}[2][]{%
  \ifstrempty{#1}{%
    \section{#2}%
  }{%
    \section[#1]{#2}%
  }%
  \enlp@sectionpageframe{#2}%
}
\newcommand{\enlp@silentsection}[1]{%
  \begingroup
  \let\beamer@atbeginsection\@empty
  \let\beamer@atbeginsections\@empty
  \section{#1}%
  \endgroup
}

% Citations rendering logic
\newcommand{\enlp@printfullcite}[1]{%
  {\color{enlpBibliographyColor}\enlp@footcitelabel{#1}}\space
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \renewcommand*{\finentrypunct}{}%
    {\color{enlpBibliographyColor}\fullcite{#1}}%
  }{%
    \ifdefstring{\enlp@bibmode}{bibtex}{%
      {\color{enlpBibliographyColor}\bibentry{#1}}%
    }{%
      \enlp@requirebibsupport{\string\framefullcite}%
    }%
  }%
}
\newcommand{\enlp@definebiblatexfootercite}{%
  \@ifundefined{enlp@biblatexfullcite}{%
    \DeclareCiteCommand{\enlp@biblatexfullcite}
      {\renewcommand*{\finentrypunct}{}}%
      {%
        {\color{enlpBibliographyColor}\printtext[bibhyperref]{%
          \mkbibbrackets{\printfield{labelprefix}\printfield{labelnumber}}%
        }}\space
        {\color{enlpBibliographyColor}\usedriver{}{\thefield{entrytype}}}%
      }%
      {\par}%
      {}%
  }{}%
}
\newcommand{\enlp@sortbibtexkeys}[1]{%
  \begingroup
  \NAT@sort@cites{#1}%
  \xdef\enlp@sortedkeys{\NAT@cite@list}%
  \endgroup
}
\newcommand{\enlp@renderfullcites@biblatex}[1]{%
  \begingroup
  \enlp@definebiblatexfootercite
  \enlp@biblatexfullcite{#1}%
  \endgroup
}
\newcommand{\enlp@renderfullcites@bibtex}[1]{%
  \begingroup
  \enlp@firstfootercitetrue
  \enlp@sortbibtexkeys{#1}%
  \@for\enlp@citekey:=\enlp@sortedkeys\do{%
    \ifenlp@firstfootercite
      \enlp@firstfootercitefalse
    \else
      \par
    \fi
    \expandafter\enlp@printfullcite\expandafter{\enlp@citekey}%
  }%
  \endgroup
}
\newcommand{\enlp@renderfullcites}[1]{%
  \enlp@requirebibsupport{\string\framefullcite}%
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \enlp@renderfullcites@biblatex{#1}%
  }{%
    \ifdefstring{\enlp@bibmode}{bibtex}{%
      \enlp@renderfullcites@bibtex{#1}%
    }{}%
  }%
}
\newcommand{\framefullcite}[1]{%
  \framefooter{\enlp@renderfullcites{#1}}%
}
\newcommand{\enlptextcite}[1]{%
  \enlp@requirebibsupport{\string\enlptextcite}%
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \cite{#1}%
  }{%
    \cite{#1}%
  }%
}
\newcommand{\enlpauthorcite}[1]{%
  \enlp@requirebibsupport{\string\enlpauthorcite}%
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \textcite{#1}%
  }{%
    \citet{#1}%
  }%
}
\newcommand{\enlpparencite}[1]{%
  \enlp@requirebibsupport{\string\enlpparencite}%
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \parencite{#1}%
  }{%
    \citep{#1}%
  }%
}

% Bibliography Frame
\newcommand{\enlp@insertbibliographyframebody}[1]{%
  \enlp@requirebibsupport{\string\insertbibliographyframe}%
  \begingroup
  \setbeamertemplate{frametitle continuation}{}%
  \setbeamerfont{bibliography item}{size=\fontsize{24}{30}\selectfont}%
  \setbeamerfont{bibliography entry author}{size=\fontsize{24}{30}\selectfont}%
  \setbeamerfont{bibliography entry title}{size=\fontsize{24}{30}\selectfont}%
  \setbeamerfont{bibliography entry location}{size=\fontsize{24}{30}\selectfont}%
  \setbeamerfont{bibliography entry note}{size=\fontsize{24}{30}\selectfont}%
  \@ifundefined{bibfont}{}{%
    \renewcommand*{\bibfont}{\fontsize{24}{30}\selectfont}%
  }%
  \ifdefstring{\enlp@bibmode}{biblatex}{%
    \begin{frame}[allowframebreaks]
      \frametitle{#1}%
      {\color{enlpBibliographyColor}\printbibliography[heading=none]}%
    \end{frame}
  }{%
    \begin{frame}[allowframebreaks]
      \frametitle{#1}%
      {\color{enlpBibliographyColor}\bibliography{\enlp@bibfiles}}%
    \end{frame}
  }%
  \endgroup
}
\newcommand{\insertbibliographyframe}{%
  \@ifstar{\enlp@insertbibliographyframewithoutsection}{\enlp@insertbibliographyframewithsection}%
}
\newcommand{\enlp@insertbibliographyframewithsection}[1][参考文献]{%
  \enlp@silentsection{#1}%
  \enlp@sectionpageframe{#1}%
  \enlp@insertbibliographyframebody{#1}%
}
\newcommand{\enlp@insertbibliographyframewithoutsection}[1][参考文献]{%
  \enlp@insertbibliographyframebody{#1}%
}

\newcommand{\enlp@resetframefooterstate}{%
  \gdef\enlp@framefooter{}%
  \global\let\enlp@autocitekeys\@empty
}
\newcommand{\enlp@renderframefooter}{%
  \ifstrempty{\enlp@framefooter}{%
    \ifenlp@autocitefooter
      \ifdefstring{\enlp@bibmode}{none}{}{%
        \ifstrempty{\enlp@autocitekeys}{}{%
          \enlp@renderfullcites{\enlp@autocitekeys}%
        }%
      }%
    \fi
  }{%
    \enlp@framefooter
  }%
}
\AtBeginEnvironment{frame}{\enlp@resetframefooterstate}
\AtBeginEnvironment{frame}{%
  \usebeamerfont{normal text}%
  \usebeamercolor[fg]{normal text}%
}

% Assign Templates
\setbeamertemplate{background}[enlp]
\setbeamertemplate{title page}[enlp]
\setbeamertemplate{headline}[enlp]
\setbeamertemplate{frametitle}[enlp]
\setbeamertemplate{footline}[enlp]
\setbeamertemplate{section page}[enlp]
\setbeamertemplate{block begin}[enlp]
\setbeamertemplate{block end}[enlp]

\mode<all>

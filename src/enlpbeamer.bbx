\ProvidesFile{enlpbeamer.bbx}[2026/04/05 ENLP Beamer biblatex bibliography style]

\RequireBibliographyStyle{numeric-comp}

\ExecuteBibliographyOptions{
  sorting=none,
  maxbibnames=99,
  giveninits=true,
  uniquename=init
}

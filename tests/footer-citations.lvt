\input regression-test.tex
\def\ENLPClassOptions{}
\ifdefined\kanjiskip
  \edef\ENLPClassOptions{dvipdfmx}
\fi
\expandafter\documentclass\expandafter[\ENLPClassOptions]{beamer}
\usetheme[bib=biblatex]{enlp}
\enlpusebibresource{references.bib}

\makeatletter
\newcommand\ENLPReport[1]{%
  \TIMO\TYPE{#1}\OMIT
}
\newcommand\ENLPReportAutoCites{%
  \ENLPReport{autocitekeys=\enlp@autocitekeys}%
}
\renewcommand\enlp@renderfullcites[1]{%
  \ENLPReport{rendered=#1}%
}
\makeatother

\begin{document}
\START
\TYPE{ENLP auto footer citation test}
\OMIT
\begin{frame}{Automatic Footer}
  Auto footer cites \cite{doe2025, smith2024} and \cite{doe2025}.
  \ENLPReportAutoCites
\end{frame}
\begin{frame}{Manual Footer}
  \framefooter{\ENLPReport{rendered=manual footer}manual footer}
  Manual footer still allows \cite{smith2024} in the body.
  \ENLPReportAutoCites
\end{frame}
\frame{No citations.\ENLPReportAutoCites}
\setkeys{beamerthemeenlp}{autocitefooter=false}
\begin{frame}{Disabled Automatic Footer}
  Auto footer should ignore \cite{doe2025}.
  \ENLPReportAutoCites
\end{frame}
\TIMO
\END
\end{document}

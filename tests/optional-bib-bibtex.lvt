  \edef\ENLPClassOptions{dvipdfmx}
\fi
\expandafter\documentclass\expandafter[\ENLPClassOptions]{beamer}
\usetheme[bib=bibtex]{enlp}
\enlpusebibresource{}

\makeatletter
\newcommand\ENLPReportBibState{%
  \TYPE{bibmode=\enlp@bibmode}%
  \edef\ENLPBibFiles{\detokenize\expandafter{\enlp@bibfiles}}%
  \TYPE{bibfiles=\ENLPBibFiles}%
}
\makeatother

